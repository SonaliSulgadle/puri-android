    {
      "title": "Traveling between Korean cities",
      "sectionType": "TABLE",
      "items": [
        {"korean": "KTX (고속철도)", "translation": "Bullet train — fastest intercity option", "detail": "Seoul to Busan: 2hr 15min, ₩59,800. Seoul to Daejeon: 50min. Departs from Seoul Station or Yongsan. Book at Korail Talk app or korail.go.kr"},
        {"korean": "SRT", "translation": "High-speed train from Suseo (Gangnam area)", "detail": "Same destinations as KTX, slightly cheaper, departs from Suseo station in southern Seoul. Book at srt.co.kr or SRT app."},
        {"korean": "고속버스 (Express bus)", "translation": "Intercity express bus — cheaper, slower", "detail": "Departs from Express Bus Terminal (강남) or Dong Seoul Bus Terminal (동서울). Book at Kobus app or kobus.co.kr or Bustago app."},
        {"korean": "국내선 비행기 (Domestic flight)", "translation": "Domestic flights", "detail": "Jeju Air, T'way, Air Seoul — often the cheapest option for Busan or Jeju. Check Naver Flights or airline apps."}
