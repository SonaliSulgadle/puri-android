      "items": [
        {"korean": "인천 (ICN)", "translation": "Incheon International", "detail": "Main international gateway — 60km from Seoul. Two terminals: T1 for most airlines, T2 for Korean Air and SkyTeam. Free shuttle runs every 5–10 min between terminals."},
        {"korean": "김포 (GMP)", "translation": "Gimpo", "detail": "Domestic flights and short-haul international (Japan, China). Directly on Seoul Metro Lines 5 and 9 — easiest airport to get to from central Seoul."},
        {"korean": "김해 (PUS)", "translation": "Gimhae / Busan", "detail": "Busan's main airport for domestic and some international routes. Busan Metro Line 3 connects to the city center."},
        {"korean": "제주 (CJU)", "translation": "Jeju Island", "detail": "Korea's busiest domestic route from Seoul — dozens of daily flights. Bus or taxi to Jeju City center from the airport."},
        {"korean": "대구 (TAE)", "translation": "Daegu", "detail": "Serves Daegu and North Gyeongbuk region — useful for visiting southeastern Korea"},
        {"korean": "청주 (CJJ)", "translation": "Cheongju", "detail": "Budget airline hub — check if your flight lands here instead of Seoul when booking"}
