    {
      "title": "Long-term rental types",
      "sectionType": "TABLE",
      "items": [
        {"korean": "월세 (Wolse)", "translation": "Monthly rent with deposit", "detail": "Standard rental. Pay a security deposit (보증금 — Bo-jeung-geum) plus monthly rent. Most accessible for foreigners. Contract usually 1 year minimum."},
        {"korean": "전세 (Jeonse)", "translation": "Lump-sum deposit, zero monthly rent", "detail": "Pay a large deposit (40–80% of property value) upfront. No monthly rent — deposit returned in full at the end. Requires significant capital — not practical for most first-time renters."},
        {"korean": "보증금 (Bo-jeung-geum)", "translation": "Security deposit", "detail": "Required for all rentals. Returned when you leave if no damages. Always confirm with a written contract."}
      ]
