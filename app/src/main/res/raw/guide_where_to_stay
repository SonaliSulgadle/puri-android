    {
      "title": "Best neighborhoods for foreigners in Seoul",
      "sectionType": "LIST",
      "items": [
        {"detail": "이태원 / 한남 (Itaewon/Hannam) — most international community, English-friendly restaurants and shops, foreigner-focused services"},
        {"detail": "홍대 (Hongdae) — young and artistic neighborhood, affordable, great transport on Metro Lines 2 and 6, active nightlife and café culture"},
        {"detail": "강남 / 서초 (Gangnam/Seocho) — expensive, corporate, extremely convenient with many international businesses"},
        {"detail": "마포 / 합정 (Mapo/Hapjeong) — local and trendy vibe, good metro access, many coffee shops and small restaurants"},
        {"detail": "잠실 (Jamsil) — quieter, family-friendly, near Han River and Lotte World, good for longer stays"}
      ]
    },
    {
      "title": "How to find a place",
      "sectionType": "LIST",
      "items": [
        {"detail": "직방 (Zigbang) app — has English mode. Best for searching one-rooms and studios with photos and prices."},
        {"detail": "다방 (Dabang) app — similar to Zigbang, good for short-term leases"},
        {"detail": "부동산 (Budongsan) — local real estate agent office. Look for 부동산 signs in any neighborhood. Agents often find better unlisted deals but usually only speak Korean. Bring a Korean-speaking friend or use Papago translator. A small agent fee (복비 — Bokbi) is typical."},
        {"detail": "Facebook groups: 'Seoul Apartments and Rooms', 'Expats in Seoul', or groups specific to your nationality"},
        {"detail": "Mapliving, Co-living Korea — English-friendly shared house companies with easy application processes"}
      ]
