        {"korean": "고시원 / 고시텔 (Gosiwon / Gositel)", "translation": "₩300,000–550,000 per month", "detail": "Very small private rooms (5–8 sqm) with shared bathroom and kitchen. Often includes utilities and WiFi. Cheapest monthly option — common near universities and subway stations."},
        {"korean": "원룸 (Wonrum — One-room)", "translation": "₩400,000–800,000 per month + deposit", "detail": "Studio apartment with private bathroom. Most common choice for foreigners. Requires a security deposit (보증금 — Bo-jeung-geum) of approximately ₩1,000,000–10,000,000."},
        {"korean": "쉐어하우스 (Share house)", "translation": "₩500,000–900,000 per month", "detail": "Western-style room in a shared house with other people. Smaller deposit required. Common in Itaewon, Mapo, Yongsan areas."}
      ]
